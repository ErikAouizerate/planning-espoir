# ── API (runtime) ────────────────────────────────
AUTH_ENABLED=true
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/gateway
KEYCLOAK_APP_GROUP=app-planning-espoir
DATA_DIR=/data
PORT=3000
# Comma-separated list of allowed browser origins. Leave empty for same-origin
# only (production behind nginx). Local dev examples:
#   CORS_ORIGINS=http://localhost:5174
#   CORS_ORIGINS=http://localhost:5174,http://planning-espoir.localhost
CORS_ORIGINS=

# ── Webapp (build-time — Vite inlines these into the bundle) ─
VITE_AUTH_ENABLED=true
VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_REALM=gateway
VITE_KEYCLOAK_CLIENT_ID=gateway
VITE_GATEWAY_URL=https://gateway.example.com
VITE_APP_GROUP=app-planning-espoir

# Absolute API origin, including the /api prefix. Empty or absent falls back to
# the relative /api (production behind nginx). Local dev examples:
#   native:           VITE_API_BASE=http://localhost:3000/api
#   docker override:  VITE_API_BASE=http://api.planning-espoir.localhost/api
VITE_API_BASE=
